# ==========================================
# ENVIRONMENT CONFIGURATION
# ==========================================

# ----- AUTHENTICATION -----
# Vocareum can supply credentials and the endpoint in the shell.
# Shell values take precedence over this file.
ANTHROPIC_API_KEY=
# Leave blank to use the SDK's default Anthropic API endpoint.
ANTHROPIC_BASE_URL=

# ----- MODEL CONFIGURATION (REQUIRED) -----
ANTHROPIC_MODEL=claude-sonnet-4-5-20250929

# Available models:
#   - claude-sonnet-4-5-20250929 (recommended)
#   - claude-haiku-4-5-20251001 (faster, cheaper)

# ----- PROJECT ROOT (REQUIRED) -----
# Absolute path to the project/starter directory
# This directory MUST contain the .claude/skills/ directory

# Vocareum workspace:
PROJECT_ROOT=/voc/work/cd14715-claude-code-classroom/project/starter

# Local development (update to your path):
# PROJECT_ROOT=/absolute/path/to/project/starter

# ----- GITHUB TOKEN (RECOMMENDED) -----
# For higher rate limits and private repository access
# Generate at: https://github.com/settings/tokens
# Required scopes: 'repo', 'read:org'
GITHUB_TOKEN=

# ----- LOGGING (OPTIONAL) -----
# Options: error, warn, info, debug
LOG_LEVEL=info

# Optional application settings
NODE_ENV=
RUN_LIVE_REVIEW=0

# Inherited from the operating system for Claude and its MCP subprocesses
PATH=
HOME=
USERPROFILE=
